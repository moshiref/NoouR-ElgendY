# Supabase backend for the NoouR Elgendy portfolio (Work Admin + public data).
# Copy to `.env` (git-ignored) or set in your host's environment variables.
# The PUBLISHABLE key is safe for browser code. NEVER add a
# service_role/secret key here — RLS policies in supabase/work_admin.sql keep
# writes restricted to signed-in admin users.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
